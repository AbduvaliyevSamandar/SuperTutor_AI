# --- Server ---
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# LLM providers — used in cascade order: groq -> openai -> gemini.
# Set just one to start; add the others as fallback.

# --- Groq (BEPUL: https://console.groq.com) ---
GROQ_API_KEY=gsk_replace_me
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3

# --- OpenAI (paid, optional fallback: https://platform.openai.com) ---
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1

# --- Google Gemini (BEPUL: https://aistudio.google.com) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Supabase (free: https://supabase.com) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_KEY=replace_me
